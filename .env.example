# --- Site ---------------------------------------------------------------
# Public URL (used for sitemap, canonical and social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on the Copyright & Takedowns page
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Data source ----------------------------------------------------------
# No token: keyless Internet Archive (public-domain films, fully playable).
# With a TMDB token: newest releases, upcoming, series, genres, cast, trailers.
MOVIE_API_BASE_URL=https://api.themoviedb.org/3
MOVIE_API_TOKEN=

# --- Your own licensed streaming servers (TMDB mode, movies) ----------------
# Comma-separated, tried in order; {id} = TMDB movie id. Supports .mp4 and .m3u8 (HLS).
# If one server fails the player switches to the next automatically.
# Only use servers you are licensed to stream from.
# MOVIE_STREAM_URL_TEMPLATE=https://cdn1.example.com/{id}/master.m3u8,https://cdn2.example.com/{id}.mp4
