# Optional. With no token the site uses the keyless Internet Archive (public-domain, fully playable).
# With a TMDB token you get the newest releases, upcoming titles, genres and trailers.
MOVIE_API_BASE_URL=https://api.themoviedb.org/3
MOVIE_API_TOKEN=

# Optional, TMDB mode only: a licensed full-film source you own. {id} is the TMDB movie id.
# Supports .mp4 or .m3u8 (HLS). Without it, the player shows the official trailer.
# MOVIE_STREAM_URL_TEMPLATE=https://cdn.example.com/films/{id}/master.m3u8
